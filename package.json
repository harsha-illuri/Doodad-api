{
  "name": "doodad-api",
  "private": true,
  "type": "module",
  "description": "Doodad's receiving service: install counts, feedback and reports, on Cloudflare (Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply doodad-api --remote",
    "db:migrate:local": "wrangler d1 migrations apply doodad-api --local",
    "sync-schema": "node scripts/sync-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
